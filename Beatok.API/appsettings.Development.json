{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "NeonConnection": "Host=HOST;Database=DB;Username=USERNAME;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true",
    "NeonNoPoolingConnection": "Host=HOST;Database=DB;Username=USERNAME;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=false"
  },
  "JwtOptions": {
    "SecretKey": "super-secret-key",
    "Issuer": "Beatok.API",
    "Audience": "BeatokFrontend",
    "ExpiresMinutes": 15
  },

  "R2Options": {
    "ServiceUrl": "your-r2-service-url",
    "AccessKey": "your-r2-access-key",
    "SecretKey": "your-r2-secret-key"
  },
  
  "GoogleAuthOptions": {
    "ClientId" : "CLIENT ID",
    "ClientSecret" : "CLIENT SECRET",
    "RedirectUri" : "https://localhost:5173/auth/google/callback"
  },

  "FrontendUrl": "https://localhost:5173"
}
